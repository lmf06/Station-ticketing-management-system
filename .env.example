SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=mysql+pymysql://station_user:replace-with-a-strong-password@127.0.0.1:3306/station_ticketing?charset=utf8mb4
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SESSION_COOKIE_SECURE=0

# MySQL connection pool (per Gunicorn worker)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Web process settings; the hosting platform may override PORT.
PORT=8000
WEB_CONCURRENCY=2
WEB_THREADS=2
WEB_TIMEOUT=30
WEB_GRACEFUL_TIMEOUT=30
WEB_KEEPALIVE=5
WEB_MAX_REQUESTS=1000
WEB_MAX_REQUESTS_JITTER=100
